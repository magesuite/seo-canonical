<?xml version="1.0"?>
<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magesuite" translate="label" sortOrder="300">
            <label>MageSuite</label>
        </tab>
        <section id="seo" translate="label" type="text" sortOrder="300" showInDefault="1">
            <label>SEO</label>
            <tab>magesuite</tab>
            <resource>MageSuite_SeoCanonical::config_seo</resource>
            <group id="canonical" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Canonical</label>
                <field id="canonical_tag_enabled" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Canonical Tag For Other Pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[Enables canonical tag for pages which Magento doesn't support out of the box like CMS ones. <a href="https://support.google.com/webmasters/answer/139066" target="_blank" rel="noopener">Read more</a>.<br>You can enable this tag for category and product pages under <b>Stores→Configuration→Catalog→Catalog</b>.]]>
                    </comment>
                </field>
                <field id="canonical_pagination_enabled" translate="label" type="select" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable canonical tag for paginated category pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[Enable canonical tag for <b>non-first</b> category pages (default Magento behaviour).<br/>When disabled, paginated category pages <b>will not</b> contain canonical tag (improvement provided by Magesuite).]]>
                    </comment>
                </field>
                <field id="remove_store_code_from_homepage" translate="label" type="select" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Remove Store Code from Homepage</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[It removes store path /xx_xx/ from the homepage.]]>
                    </comment>
                </field>
                <field id="og_url_match_canonical_enabled" translate="label" type="select" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Align og:url with canonical on paginated category pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[When enabled, og:url meta tag will match the canonical URL on paginated category pages (e.g. <b>?p=1</b>). Prevents conflicting signals to social platforms and search engines.]]>
                    </comment>
                </field>
            </group>
            <group id="category" translate="label" type="text" sortOrder="2" showInDefault="1">
                <label>Category</label>
                <field id="prev_next_link_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Include prev and next link on category page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
